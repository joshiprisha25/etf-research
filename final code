def run_ols(y, X):
    """
    OLS with HC3 robust standard errors.
    """
    data = pd.concat([y, X], axis=1).dropna()
    y_clean = data.iloc[:, 0]
    X_clean = data.iloc[:, 1:]
    X_clean = sm.add_constant(X_clean)

    model = sm.OLS(y_clean, X_clean).fit(cov_type="HC3")
    return model

def fit_all_models_for_sector(df, sector):
    """
    Returns dict of fitted models for a given sector.
    """
    y = df[f"{sector}_excess"]

    models = {}

    X_capm = df[["MKT_RF"]]
    X_ff3 = df[["MKT_RF", "SMB", "HML"]]
    X_carhart = df[["MKT_RF", "SMB", "HML", "MOM"]]
    X_carhart_d2y = df[["MKT_RF", "SMB", "HML", "MOM", "d2y"]]

    models["CAPM"] = run_ols(y, X_capm)
    models["FF3"] = run_ols(y, X_ff3)
    models["Carhart4"] = run_ols(y, X_carhart)
    models["Carhart4 + d2y"] = run_ols(y, X_carhart_d2y)

    return models

