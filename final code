def classify_rate_state(x, rise_thr=RISE_THRESHOLD, fall_thr=FALL_THRESHOLD):
    if pd.isna(x):
        return np.nan
    if x > rise_thr:
        return "Rising"
    elif x < fall_thr:
        return "Falling"
    else:
        return "Neutral"

def annualized_return_from_daily(returns: pd.Series) -> float:
    returns = returns.dropna()
    if len(returns) == 0:
        return np.nan
    gross = (1.0 + returns).prod()
    return gross ** (252.0 / len(returns)) - 1.0

def annualized_garch_vol_from_daily(returns: pd.Series, p=1, q=1) -> float:
    """
    Fit GARCH(p,q) to daily returns and annualize the average fitted conditional vol.
    Returns volatility in decimal units, e.g. 0.20 = 20%.
    """
    returns = returns.dropna()
    if len(returns) < 80:
        return np.nan

    x = 100.0 * returns

    try:
        model = arch_model(
            x,
            mean="Constant",
            vol="GARCH",
            p=p,
            q=q,
            dist="normal",
            rescale=False
        )
        res = model.fit(disp="off")
        cond_vol_pct = res.conditional_volatility  # percent units
        ann_vol = cond_vol_pct.mean() / 100.0 * np.sqrt(252.0)
        return float(ann_vol)
    except Exception:
        return np.nan

def pct_fmt(x):
    if pd.isna(x):
        return ""
    return f"{100*x:.1f}%"

def bootstrap_by_month(series: pd.Series, stat_func, n_boot=300, rng=None):
    """
    Block bootstrap by month:
    - series index must be daily DatetimeIndex
    - resample whole months with replacement
    - stat_func computes a scalar from the bootstrapped daily return series
    """
    series = series.dropna()
    if len(series) == 0:
        return np.nan, np.nan, np.array([])

    df = series.to_frame("ret").copy()
    df["Month"] = df.index.to_period("M")

    month_groups = [g["ret"].copy() for _, g in df.groupby("Month")]
    n_months = len(month_groups)

    if n_months < 6:
        return np.nan, np.nan, np.array([])

    boot_stats = []

    for _ in range(n_boot):
        picked = rng.integers(0, n_months, size=n_months)
        sampled = pd.concat([month_groups[i] for i in picked], ignore_index=True)
        val = stat_func(sampled)
        if np.isfinite(val):
            boot_stats.append(val)

    boot_stats = np.array(boot_stats, dtype=float)

    if len(boot_stats) == 0:
        return np.nan, np.nan, boot_stats

    lo = np.percentile(boot_stats, CI_LOW)
    hi = np.percentile(boot_stats, CI_HIGH)
    return lo, hi, boot_stats

def make_err_arrays(center, low, high):
    """
    Convert lower/upper CI bounds into matplotlib asymmetric error arrays.
    """
    lower = center - low
    upper = high - center

    lower = np.where(np.isfinite(lower) & (lower >= 0), lower, np.nan)
    upper = np.where(np.isfinite(upper) & (upper >= 0), upper, np.nan)

    return np.vstack([lower, upper])

def local_ylim(vals, include_zero=False, positive_only=False):
    vals = np.asarray(vals, dtype=float)
    vals = vals[np.isfinite(vals)]

    if len(vals) == 0:
        return (0.0, 1.0) if positive_only else (-1.0, 1.0)

    vmin = vals.min()
    vmax = vals.max()

    if include_zero:
        vmin = min(vmin, 0.0)
        vmax = max(vmax, 0.0)

    if positive_only:
        vmin = max(0.0, vmin)

    if np.isclose(vmin, vmax):
        if positive_only:
            return (0.0, vmax * 1.25 if vmax > 0 else 1.0)
        margin = max(1.0, 0.15 * abs(vmin)) if abs(vmin) > 0 else 1.0
        return (vmin - margin, vmax + margin)

    margin = 0.15 * (vmax - vmin)
    low = vmin - margin
    high = vmax + margin

    if positive_only:
        low = max(0.0, low)

    return low, high

