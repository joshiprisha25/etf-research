def run_regression_by_regime(data, sector):
    y = data[f"{sector}_excess"]
    X = data[["MKT_RF", "SMB", "HML", "MOM", "d2y"]]
    X = sm.add_constant(X)
    model = sm.OLS(y, X).fit(cov_type="HC3")

    coef = model.params["d2y"]
    se = model.bse["d2y"]
    t = model.tvalues["d2y"]
    ci_low, ci_high = model.conf_int().loc["d2y"]

    return coef, se, t, ci_low, ci_high, model.rsquared_adj

