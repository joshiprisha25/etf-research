def extract_arrays(df, state, center_col, low_col, high_col):
    sub = (
        df[df["Rate_State"] == state]
        .set_index("Sector")
        .reindex(sector_order)
    )

    center = sub[center_col].values.astype(float)
    low = sub[low_col].values.astype(float)
    high = sub[high_col].values.astype(float)
    return center, low, high

