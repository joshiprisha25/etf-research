        sub = df.set_index("Country").reindex(country_order)
    else:
        sub = df[df["Regime"] == regime].set_index("Country").reindex(country_order)
    return (
        sub["gamma"].values,
        sub["gamma_lo"].values,
        sub["gamma_hi"].values
    )

