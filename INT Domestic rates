    "US":       ("DGS2", "fred"),
    "UK":       ("IRLTLT01GBM156N", "fred"),
    "Germany":  ("IRLTLT01DEM156N", "fred"),
    "Japan":    ("IRLTLT01JPM156N", "fred"),
    "Canada":   ("IRLTLT01CAM156N", "fred"),
    "Australia":("IRLTLT01AUM156N", "fred")
}

monthly_yields_domestic = {}

for c in country_order:
    code, src = country_yield_series[c]
    y = pdr.DataReader(code, src, START_DATE, END_DATE).ffill()
    y_m = y.resample("M").mean()
    y_m.index = y_m.index.to_period("M")
    col = y_m.columns[0]

    y_m["d2y"] = y_m[col].diff(1)
    y_m["d2y_3m"] = y_m[col].diff(RATE_CHANGE_LAG_MONTHS)
    y_m["Rate_State"] = y_m["d2y_3m"].apply(classify_rate_state)

    monthly_yields_domestic[c] = y_m[["d2y", "Rate_State"]]

