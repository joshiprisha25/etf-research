def classify_rate_state(x):
    if pd.isna(x):
        return np.nan
    if x > RISE_THRESHOLD:
        return "Rising"
    elif x < FALL_THRESHOLD:
        return "Falling"
    else:
        return "Neutral"

def run_ols_hc3(y, X, min_obs=MIN_OBS):
    data = pd.concat([y, X], axis=1).dropna()
    if data.shape[0] < min_obs:
        return None
    y_clean = data.iloc[:, 0]
    X_clean = sm.add_constant(data.iloc[:, 1:])
    model = sm.OLS(y_clean, X_clean).fit(cov_type="HC3")
    return model

def make_err_arrays(center, low, high):
    lower = center - low
    upper = high - center
    lower = np.where(lower >= 0, lower, np.nan)
    upper = np.where(upper >= 0, upper, np.nan)
    return np.vstack([lower, upper])

def local_ylim(vals, include_zero=False, positive_only=False):
    vals = np.asarray(vals)
    vals = vals[np.isfinite(vals)]
    if len(vals) == 0:
        return (-0.05, 0.05)
    vmin, vmax = vals.min(), vals.max()
    if include_zero:
        vmin = min(vmin, 0)
        vmax = max(vmax, 0)
    if positive_only:
        vmin = max(0, vmin)
    margin = 0.15 * (vmax - vmin)
    return (vmin - margin, vmax + margin)

def to_month_period_index(df):
    if not isinstance(df.index, pd.PeriodIndex):
        df.index = pd.to_datetime(df.index).to_period("M")
    return df

def annualized_return_from_daily(returns):
    returns = returns.dropna()
    if len(returns) == 0:
        return np.nan
    gross = (1 + returns).prod()
    return gross ** (252 / len(returns)) - 1

def annualized_garch_vol_from_daily(returns):
    returns = returns.dropna()
    if len(returns) < 80:
        return np.nan
    x = 100 * returns
    try:
        model = arch_model(x, mean="Constant", vol="GARCH", p=1, q=1, dist="normal", rescale=False)
        res = model.fit(disp="off")
        cond_vol = res.conditional_volatility
        return cond_vol.mean() / 100 * np.sqrt(252)
    except:
        return np.nan

def bootstrap_by_month(series, stat_func, n_boot=300, rng=None):
    if rng is None:
        rng = np.random.default_rng(42)
    series = series.dropna()
    if len(series) == 0:
        return np.nan, np.nan, np.array([])
    df = series.to_frame("ret")
    df["Month"] = df.index.to_period("M")
    groups = [g["ret"] for _, g in df.groupby("Month")]
    if len(groups) < 6:
        return np.nan, np.nan, np.array([])
    stats = []
    for _ in range(n_boot):
        idx = rng.integers(0, len(groups), size=len(groups))
        sampled = pd.concat([groups[i] for i in idx])
        val = stat_func(sampled)
        if np.isfinite(val):
            stats.append(val)
    stats = np.array(stats)
    if len(stats) == 0:
        return np.nan, np.nan, stats
    return np.percentile(stats, 2.5), np.percentile(stats, 97.5), stats

