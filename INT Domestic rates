        ann_ret = annualized_return_from_daily(sub)
        ann_vol = annualized_garch_vol_from_daily(sub)
        ret_lo, ret_hi, _ = bootstrap_by_month(sub, annualized_return_from_daily, rng=rng)
        vol_lo, vol_hi, _ = bootstrap_by_month(sub, annualized_garch_vol_from_daily, rng=rng)
        rows.append({
            "Rate_State": state,
            "Country": c,
            "Annualized_Return": ann_ret,
            "Return_CI_Low": ret_lo,
            "Return_CI_High": ret_hi,
            "GARCH_Annualized_Vol": ann_vol,
            "Vol_CI_Low": vol_lo,
            "Vol_CI_High": vol_hi
