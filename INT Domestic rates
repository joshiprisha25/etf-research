# ============================================

print("Running domestic gamma regressions for countries...")

results_full_domestic = []
results_regime_domestic = []

for c in country_order:
    cm = country_masters[c]

    # Full sample
    y = cm[f"{c}_excess"]
    X = cm[["MKT_RF", "d2y"]]
    model = run_ols_hc3(y, X)
    if model is not None:
        ci = model.conf_int()
        results_full_domestic.append({
            "Country": c,
            "gamma": model.params["d2y"],
            "gamma_lo": ci.loc["d2y", 0],
            "gamma_hi": ci.loc["d2y", 1]
        })

    # By domestic regime
    for regime in regime_order:
        sub = cm[cm["Rate_State"] == regime]
        y_r = sub[f"{c}_excess"]
        X_r = sub[["MKT_RF", "d2y"]]
        model_r = run_ols_hc3(y_r, X_r)
        if model_r is None:
            continue
        ci_r = model_r.conf_int()
        results_regime_domestic.append({
            "Country": c,
            "Regime": regime,
            "gamma": model_r.params["d2y"],
            "gamma_lo": ci_r.loc["d2y", 0],
            "gamma_hi": ci_r.loc["d2y", 1]
        })

